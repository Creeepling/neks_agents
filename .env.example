# -----------------------------------------------
# Real Estate Agent Backend — Environment Config
# Copy this file to .env and fill in your values.
# -----------------------------------------------

# Required: Get from https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# Required: Generate a secure random key for JWT signing
# Run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# (Firestore is now used for the database)

# Optional: JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: Gemini model to use
GEMINI_MODEL=gemini-3-flash-preview

# External Tools
# DADATA_API_KEY=your_dadata_key_here
# TWOGIS_API_KEY=your_2gis_key_here
# APIFY_API_TOKEN=your_apify_api_token_here

# Optional: "local" or "production"
ENVIRONMENT=local
