# -----------------------------------------------
# Real Estate Agent Backend — Environment Config
# Copy this file to .env and fill in your values.
# -----------------------------------------------

# Required: Get from https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# Required: Generate a secure random key for JWT signing
# Run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Optional: defaults to local SQLite (app.db in project root)
# For production / Cloud Run, set to a PostgreSQL URL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./app.db

# Optional: JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: Gemini model to use
GEMINI_MODEL=gemini-2.0-flash

# Optional: "local" or "production"
ENVIRONMENT=local
